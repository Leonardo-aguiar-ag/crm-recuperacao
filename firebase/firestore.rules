rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data;
    }

    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(uid()))
        && userDoc().keys().hasAny(['role'])
        ? userDoc().role
        : 'vendedor';
    }

    function isManager() {
      return signedIn() && role() in ['admin', 'gerente', 'supervisor'];
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    // Os registros antigos usam userId; alguns registros administrativos
    // também usam organizationId. Ambos permanecem suportados.
    function belongsToUser(data) {
      return signedIn()
        && ((data.keys().hasAny(['userId']) && data.userId == uid())
          || (data.keys().hasAny(['organizationId']) && data.organizationId == uid()));
    }

    function canRead(data) {
      return isManager() || belongsToUser(data);
    }

    function canCreate(data) {
      return signedIn()
        && (isAdmin()
          || (data.keys().hasAny(['userId']) && data.userId == uid())
          || (data.keys().hasAny(['organizationId']) && data.organizationId == uid()));
    }

    function preservesOwner(existing, incoming) {
      return incoming.keys().hasAny(['userId'])
        && incoming.userId == existing.userId
        && (!existing.keys().hasAny(['organizationId'])
          || incoming.organizationId == existing.organizationId)
        && (!existing.keys().hasAny(['createdBy'])
          || incoming.createdBy == existing.createdBy);
    }

    function canUpdate(existing, incoming) {
      return isManager()
        || (belongsToUser(existing)
          && preservesOwner(existing, incoming)
          && ((incoming.keys().hasAny(['userId']) && incoming.userId == uid())
            || (incoming.keys().hasAny(['organizationId']) && incoming.organizationId == uid())));
    }

    function safeAudit() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'acao', 'detalhes', 'timestamp',
          'userAgent', 'organizationId', 'createdAt'
        ])
        && request.resource.data.userId == uid();
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      // O autocadastro só pode criar um perfil básico de vendedor.
      // organizationId e papéis privilegiados são atribuídos por processo confiável.
      allow create: if signedIn()
        && uid() == userId
        && request.resource.data.keys().hasOnly([
          'nome', 'email', 'role', 'servico', 'createdAt', 'telefone',
          'cidade', 'instagram', 'updatedAt', 'fotoURL'
        ])
        && (!request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role == 'vendedor');
      allow update: if signedIn() && (
        (uid() == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome', 'email', 'telefone', 'cidade', 'instagram',
            'servico', 'updatedAt', 'fotoURL'
          ]))
        || (isAdmin()
          && userId != uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'organizationId', 'nome', 'email', 'telefone',
            'cidade', 'instagram', 'servico', 'updatedAt', 'fotoURL'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            || request.resource.data.role in ['vendedor', 'gerente', 'supervisor', 'admin'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId'])
            || (request.resource.data.organizationId is string
              && request.resource.data.organizationId.size() > 0)))
      );
      allow delete: if isAdmin() && userId != uid();
    }

    match /audit_events/{eventId} {
      allow create: if safeAudit();
      allow read: if signedIn()
        && (resource.data.userId == uid() || isManager());
      allow update, delete: if false;
    }

    match /notificacoes/{id} {
      allow read, update, delete: if signedIn()
        && (resource.data.userId == uid() || isManager());
      allow create: if signedIn()
        && (request.resource.data.userId == uid() || isManager());
    }

    match /clients/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /leads/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /tarefas/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    // Coleções de configuração, metas, filtros salvos e etiquetas.
    match /statuses/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /leadStatuses/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /pracas/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /administradoras/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /acomodacoes/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /coparticipacoes/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /modalidades/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /fontesVenda/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /pessoas/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /filtrosSalvos/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /csv_mappings/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /configuracoes/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /lixeira/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /import_jobs/{id} {
      allow read: if signedIn()
        && (resource.data.user_id == uid() || isManager());
      allow create: if signedIn()
        && request.resource.data.user_id == uid()
        && request.resource.data.organization_id == uid()
        && request.resource.data.status == 'IMPORTING'
        && request.resource.data.keys().hasOnly([
          'organization_id', 'user_id', 'original_filename', 'file_hash',
          'total_rows', 'valid_rows', 'invalid_rows', 'created_count',
          'updated_count', 'skipped_count', 'failed_count', 'status',
          'started_at', 'completed_at', 'error_summary', 'origin',
          'base_legal', 'base_legal_declarada_em'
        ]);
      allow update: if signedIn()
        && resource.data.user_id == uid()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'created_count', 'updated_count', 'skipped_count',
          'failed_count', 'completed_at', 'error_summary'
        ])
        && request.resource.data.status in ['COMPLETED', 'COMPLETED_WITH_ERRORS']
        && request.resource.data.created_count is int
        && request.resource.data.updated_count is int
        && request.resource.data.skipped_count is int
        && request.resource.data.failed_count is int;
    }

    // Não há regra curinga permissiva: coleções novas devem receber
    // regras explícitas antes de serem usadas pelo frontend.
  }
}
