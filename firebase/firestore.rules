rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedApp() {
      return request.appCheck != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function profile(userId) {
      return get(/databases/$(database)/documents/usuarios/$(userId)).data;
    }

    function hasProfile(userId) {
      return exists(/databases/$(database)/documents/usuarios/$(userId));
    }

    function organizationId() {
      return signedIn() && hasProfile(uid())
        && profile(uid()).keys().hasAny(['organizationId'])
        ? profile(uid()).organizationId
        : uid();
    }

    function hasSecondFactor() {
      return signedIn()
        && request.auth.token.firebase.keys().hasAny(['sign_in_second_factor']);
    }

    function role() {
      return signedIn() && hasProfile(uid())
        && profile(uid()).keys().hasAny(['role'])
        ? profile(uid()).role
        : 'vendedor';
    }

    function isManager() {
      return signedIn()
        && (role() in ['gerente', 'supervisor']
          || (role() == 'admin' && hasSecondFactor()));
    }

    function isAdmin() {
      return signedIn() && role() == 'admin' && hasSecondFactor();
    }

    // Um documento pertence à organização do usuário quando declara o tenant
    // explicitamente ou quando é um registro legado cujo dono pertence ao tenant.
    function sameOrganization(data) {
      return signedIn()
        && data.keys().hasAny(['organizationId'])
        && data.organizationId == organizationId();
    }

    function legacyOwnedBySameOrganization(data) {
      return signedIn()
        && data.keys().hasAny(['userId'])
        && hasProfile(data.userId)
        && profile(data.userId).keys().hasAny(['organizationId'])
        && profile(data.userId).organizationId == organizationId();
    }

    function belongsToUser(data) {
      return signedIn()
        && data.keys().hasAny(['userId'])
        && data.userId == uid()
        && (!data.keys().hasAny(['organizationId']) || data.organizationId == organizationId());
    }

    function canRead(data) {
      return verifiedApp()
        && (belongsToUser(data) || (isManager() && (sameOrganization(data) || legacyOwnedBySameOrganization(data))));
    }

    function canCreate(data) {
      return verifiedApp() && signedIn()
        && ((data.keys().hasAny(['organizationId'])
          && data.organizationId == organizationId())
          || (!data.keys().hasAny(['organizationId'])
            && data.keys().hasAny(['userId']) && data.userId == uid()))
        && (isAdmin() || (data.keys().hasAny(['userId']) && data.userId == uid()));
    }

    function preservesTenant(existing, incoming) {
      return (existing.keys().hasAny(['organizationId'])
        && incoming.keys().hasAny(['organizationId'])
        && incoming.organizationId == existing.organizationId
        && incoming.organizationId == organizationId())
        || (!existing.keys().hasAny(['organizationId'])
          && !incoming.keys().hasAny(['organizationId'])
          && legacyOwnedBySameOrganization(existing));
    }

    function preservesOwner(existing, incoming) {
      return incoming.keys().hasAny(['userId'])
        && existing.keys().hasAny(['userId'])
        && incoming.userId == existing.userId
        && (!existing.keys().hasAny(['createdBy'])
          || (incoming.keys().hasAny(['createdBy']) && incoming.createdBy == existing.createdBy));
    }

    function canUpdate(existing, incoming) {
      return verifiedApp() && canRead(existing)
        && preservesTenant(existing, incoming)
        && (isManager() || (belongsToUser(existing) && preservesOwner(existing, incoming)));
    }

    function safeAudit() {
      return verifiedApp() && signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'acao', 'detalhes', 'timestamp',
          'userAgent', 'organizationId', 'createdAt'
        ])
        && request.resource.data.userId == uid()
        && request.resource.data.organizationId == organizationId();
    }

    match /usuarios/{userId} {
      allow read: if verifiedApp() && signedIn() && (uid() == userId
        || (isManager() && resource.data.organizationId == organizationId()));
      allow create: if verifiedApp() && signedIn() && uid() == userId
        && (!request.resource.data.keys().hasAny(['organizationId'])
          || request.resource.data.organizationId == organizationId());
      allow update: if verifiedApp() && signedIn() && (isAdmin()
        || (uid() == userId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.role == resource.data.role));
      allow delete: if verifiedApp() && isAdmin() && userId != uid()
        && resource.data.organizationId == organizationId();
    }

    match /audit_events/{eventId} {
      allow create: if safeAudit();
      allow read: if verifiedApp() && signedIn() && (resource.data.userId == uid()
        || (isManager() && resource.data.organizationId == organizationId()));
      // Eventos de auditoria são append-only; nem administradores podem alterá-los.
      allow update, delete: if false;
    }

    match /notificacoes/{id} {
      allow read, update, delete: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
    }

    match /import_jobs/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
    }

    match /{collection}/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }
  }
}
