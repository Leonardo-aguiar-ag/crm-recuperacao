rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data;
    }

    function role() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(uid()))
        ? userDoc().role
        : 'vendedor';
    }

    function isManager() {
      return signedIn() && role() in ['admin', 'gerente', 'supervisor'];
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    // Os registros antigos usam userId; alguns registros administrativos
    // também usam organizationId. Ambos permanecem suportados.
    function belongsToUser(data) {
      return signedIn()
        && (data.userId == uid() || data.organizationId == uid());
    }

    function canRead(data) {
      return isManager() || belongsToUser(data);
    }

    function canCreate(data) {
      return signedIn()
        && (isAdmin() || data.userId == uid() || data.organizationId == uid());
    }

    function preservesOwner(existing, incoming) {
      return incoming.userId == existing.userId
        && (!existing.keys().hasAny(['organizationId'])
          || incoming.organizationId == existing.organizationId)
        && (!existing.keys().hasAny(['createdBy'])
          || incoming.createdBy == existing.createdBy);
    }

    function canUpdate(existing, incoming) {
      return isManager()
        || (belongsToUser(existing)
          && preservesOwner(existing, incoming)
          && (incoming.userId == uid() || incoming.organizationId == uid()));
    }

    function safeAudit() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'acao', 'detalhes', 'timestamp',
          'userAgent', 'organizationId', 'createdAt'
        ])
        && request.resource.data.userId == uid();
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && (uid() == userId || isManager());
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn()
        && (isAdmin() || (uid() == userId
          && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin() && userId != uid();
    }

    match /audit_events/{eventId} {
      allow create: if safeAudit();
      allow read: if signedIn()
        && (resource.data.userId == uid() || isManager());
      allow update, delete: if isAdmin();
    }

    match /notificacoes/{id} {
      allow read, update, delete: if signedIn()
        && (resource.data.userId == uid() || isManager());
      allow create: if signedIn()
        && (request.resource.data.userId == uid() || isManager());
    }

    match /clients/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /leads/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /tarefas/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    // Coleções de configuração, metas, filtros salvos e etiquetas.
    match /statuses/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /leadStatuses/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /pracas/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /administradoras/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /acomodacoes/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /coparticipacoes/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /modalidades/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /fontesVenda/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /pessoas/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /filtrosSalvos/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /configuracoes/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /lixeira/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }

    match /import_jobs/{id} {
      allow read: if signedIn()
        && (resource.data.user_id == uid() || isManager());
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow update: if signedIn()
        && (resource.data.user_id == uid() || isManager());
    }

    // Qualquer coleção futura fica protegida por padrão, mas continua
    // compatível com documentos que carreguem userId/organizationId.
    match /{collection}/{id} {
      allow read: if canRead(resource.data);
      allow create: if canCreate(request.resource.data);
      allow update: if canUpdate(resource.data, request.resource.data);
      allow delete: if canRead(resource.data);
    }
  }
}
